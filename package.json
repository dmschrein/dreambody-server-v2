{
  "name": "dreambody-server-v2",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "cd cdk && tsc && cd ..",
    "lint": "eslint . --fix && prettier . --write --log-level silent",
    "format": "prettier . --write --log-level silent",
    "synth": "cd cdk && cdk synth && cd ..",
    "synth:local": "cross-env AWS_LAMBDA_NODEJS_FORCE_LOCAL=1 cd cdk && cdk synth && cd ..",
    "test": "vitest --coverage",
    "verify": "npm run lint && npm run build && vitest run && npm run synth",
    "clean:build": "find . -type f \\( -name \"*.js\" -o -name \"*.d.ts\" \\) ! -path \"./node_modules/*\" ! -path \"./cdk.out/*\" -delete",
    "test:ws": "node scripts/test-ws.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmschrein/dreambody-server-v2.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dmschrein/dreambody-server-v2/issues"
  },
  "homepage": "https://github.com/dmschrein/dreambody-server-v2#readme",
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4"
  }
}
